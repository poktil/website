{
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "headers": [
      {
        "source": "**/*.mp4",
        "headers": [
          { "key": "Cache-Control", "value": "public,max-age=3600" },
          { "key": "Content-Type", "value": "video/mp4" }
        ]
      },
      {
        "source": "**/*.webp",
        "headers": [
          { "key": "Cache-Control", "value": "public,max-age=3600" },
          { "key": "Content-Type", "value": "image/webp" }
        ]
      }
    ]
  }
}
